{
  "devDependencies": {
    "sass": "^1.108.1"
  },
  
  "name": "alexbanexx-soluciones-it",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sass": "sass scss/main.scss css/styles.css --style=expanded",
    "sass:watch": "sass --watch scss/main.scss css/styles.css --source-map",
    "build": "sass scss/main.scss css/styles.css --style=compressed --no-source-map",
    "compile": "sass scss/main.scss css/styles.css --watch"    
  },

  "browserslist": [
    "defaults"
  ]
}
